<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_grow_monthly_summary_list" model="ir.ui.view">
        <field name="name">grow.monthly.summary.list</field>
        <field name="model">grow.monthly.summary</field>
        <field name="arch" type="xml">
            <list string="Monthly Summaries" decoration-success="net_monthly_pl &gt; 0"
                  decoration-danger="net_monthly_pl &lt; 0" default_order="year desc, month desc">
                <field name="month"/>
                <field name="year"/>
                <field name="user_id"/>
                <field name="trading_days"/>
                <field name="opening_balance" widget="monetary"/>
                <field name="total_monthly_profit" widget="monetary" sum="Total Monthly Profit"/>
                <field name="total_monthly_loss" widget="monetary" sum="Total Monthly Loss"/>
                <field name="net_monthly_pl" widget="monetary" sum="Total Net P/L"/>
                <field name="average_daily_pl" widget="monetary"/>
                <field name="closing_balance" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_grow_monthly_summary_form" model="ir.ui.view">
        <field name="name">grow.monthly.summary.form</field>
        <field name="model">grow.monthly.summary</field>
        <field name="arch" type="xml">
            <form string="Monthly Trading Summary">
                <header>
                    <button name="action_recompute_all" type="object" string="Recompute"
                            groups="grow_intraday_trading.group_trading_supervisor"
                            help="Manually re-derive every total from the underlying trades. Only needed after a direct database import/restore."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="month"/>
                            <field name="year"/>
                            <field name="user_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Balance">
                            <field name="opening_balance" widget="monetary" readonly="1"/>
                            <field name="closing_balance" widget="monetary" readonly="1"/>
                            <field name="trading_days" readonly="1"/>
                        </group>
                    </group>
                    <group string="Performance">
                        <field name="total_monthly_profit" widget="monetary" readonly="1"/>
                        <field name="total_monthly_loss" widget="monetary" readonly="1"/>
                        <field name="net_monthly_pl" widget="monetary" readonly="1"/>
                        <field name="average_daily_pl" widget="monetary" readonly="1"/>
                        <field name="best_winning_streak" readonly="1"/>
                        <field name="best_losing_streak" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Daily Summaries">
                            <field name="daily_summary_ids" readonly="1">
                                <list decoration-success="net_daily_pl &gt; 0" decoration-danger="net_daily_pl &lt; 0">
                                    <field name="date"/>
                                    <field name="opening_balance" widget="monetary"/>
                                    <field name="net_daily_pl" widget="monetary"/>
                                    <field name="closing_balance" widget="monetary"/>
                                    <field name="trade_count"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_grow_monthly_summary_search" model="ir.ui.view">
        <field name="name">grow.monthly.summary.search</field>
        <field name="model">grow.monthly.summary</field>
        <field name="arch" type="xml">
            <search string="Search Monthly Summaries">
                <field name="year"/>
                <field name="user_id"/>
                <filter string="My Summaries" name="filter_my" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter string="Trader" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Year" name="groupby_year" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_grow_monthly_summary_graph" model="ir.ui.view">
        <field name="name">grow.monthly.summary.graph</field>
        <field name="model">grow.monthly.summary</field>
        <field name="arch" type="xml">
            <graph string="Monthly P/L" type="bar">
                <field name="month" type="row"/>
                <field name="net_monthly_pl" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_grow_monthly_summary_pivot" model="ir.ui.view">
        <field name="name">grow.monthly.summary.pivot</field>
        <field name="model">grow.monthly.summary</field>
        <field name="arch" type="xml">
            <pivot string="Monthly Performance">
                <field name="user_id" type="row"/>
                <field name="year" type="col"/>
                <field name="net_monthly_pl" type="measure"/>
                <field name="total_monthly_profit" type="measure"/>
                <field name="total_monthly_loss" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_grow_monthly_summary" model="ir.actions.act_window">
        <field name="name">Monthly Summaries</field>
        <field name="res_model">grow.monthly.summary</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_grow_monthly_summary_search"/>
        <field name="context">{'search_default_filter_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No monthly summaries yet
            </p>
            <p>
                A Monthly Summary is generated automatically as soon as a daily summary
                exists for that month.
            </p>
        </field>
    </record>

</odoo>
